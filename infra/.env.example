# =============================================================================
# Copy this file to infra/.env and fill in every value before running
# docker compose up.  Never commit the real .env to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# GCP
# -----------------------------------------------------------------------------
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=us-central1

# Absolute path on the HOST machine to your GCP service-account JSON key.
# This file is bind-mounted into the containers as read-only.
GCP_KEYFILE_PATH=/absolute/path/to/your/gcp-keyfile.json

# Same path, used directly by the google-cloud-* Python clients inside scripts/.
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/your/gcp-keyfile.json

# -----------------------------------------------------------------------------
# BigQuery datasets
# -----------------------------------------------------------------------------
BQ_DATASET_RAW=nyc_taxi_raw
BQ_DATASET_ANALYTICS=nyc_taxi_analytics

# -----------------------------------------------------------------------------
# PostgreSQL (Airflow metadata DB)
# -----------------------------------------------------------------------------
POSTGRES_USER=airflow
POSTGRES_PASSWORD=airflow          # change in any non-local environment
POSTGRES_DB=airflow

# -----------------------------------------------------------------------------
# Airflow core
# -----------------------------------------------------------------------------
# UID of the host user that owns the mounted ./airflow/logs directory.
# Run: echo $(id -u) to find yours.
AIRFLOW_UID=50000

# 32-url-safe-base64-encoded bytes.  Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW__CORE__FERNET_KEY=your-fernet-key-here

# Random secret used to sign webserver sessions.  Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
AIRFLOW__WEBSERVER__SECRET_KEY=your-webserver-secret-key-here

# -----------------------------------------------------------------------------
# Airflow initial admin user (used only by the airflow-init service)
# -----------------------------------------------------------------------------
_AIRFLOW_WWW_USER_USERNAME=admin
_AIRFLOW_WWW_USER_PASSWORD=admin   # change before exposing the webserver
_AIRFLOW_WWW_USER_EMAIL=admin@example.com

# -----------------------------------------------------------------------------
# dbt
# -----------------------------------------------------------------------------
DBT_TARGET=prod

# Path to the GCP keyfile INSIDE the container (matches the bind-mount target).
# Used by dbt profiles.yml prod target via env_var('DBT_KEYFILE_PATH').
DBT_KEYFILE_PATH=/opt/airflow/keys/gcp-keyfile.json
